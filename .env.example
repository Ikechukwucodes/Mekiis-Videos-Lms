# Server
PORT=5000
NODE_ENV=development

# Database
# Leave blank to use an embedded MongoDB that persists to .mongo-data
# Or set a real Atlas / local URI:
# MONGODB_URI=mongodb://127.0.0.1:27017/lms_platform
MONGODB_URI=
MONGO_DATA_DIR=.mongo-data

# Authentication — generate a long random string before production
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
