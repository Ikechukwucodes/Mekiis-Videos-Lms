{
  "name": "lms-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready Learning Management System (LMS)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:all": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "test": "npm test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "lms",
    "learning-management-system",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC"
}
